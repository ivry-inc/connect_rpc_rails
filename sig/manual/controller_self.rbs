# The class-level state ConnectRpcRails::Controller installs via `extend ClassMethods`.
# `self.class` on the including controller can't be typed from the module body alone,
# so the mix-in declares this as part of its self-type.
module ConnectRpcRails
  interface _ConnectControllerClass
    def connect_registration: () -> ServiceRegistration

    def connect_rpcs: () -> Hash[String, untyped]

    def name: () -> String?

    # ActiveSupport::Rescuable, and the class_attribute `map_connect_errors` stores its
    # mapping in.
    def rescue_from: (untyped, with: Symbol) -> void

    def connect_error_mapping: () -> Hash[Class, Symbol]

    def connect_error_mapping=: (Hash[Class, Symbol]) -> void
  end

  interface _ConnectControllerSelf
    def class: () -> _ConnectControllerClass

    def dispatch_connect_rpc: (ServiceRegistration::Rpc) -> void
  end
end
